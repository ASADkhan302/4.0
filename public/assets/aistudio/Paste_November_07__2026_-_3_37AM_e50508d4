      almari_id: targetAlmari.id,
      almari_code: targetAlmari.code,
      almari_name: targetAlmari.name_en,
      shelf_no: targetShelf,
      cupboard: targetAlmari.code,
      shelf: `Shelf ${targetShelf}`,
      placement_locked: true,
      location_source: 'manual',
    };

