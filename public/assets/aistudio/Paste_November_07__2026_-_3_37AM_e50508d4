    const updatedList = books.map((b) => (b.id === book.id ? updatedBook : b));
    persistManualBookShelfAssignments([updatedBook]);
    if (onUpdateBooks) onUpdateBooks(updatedList);
    setToastMessage({
      type: 'success',
      text: `Removed "${book.book_name}" from shelf to Unassigned Drawer.`,
