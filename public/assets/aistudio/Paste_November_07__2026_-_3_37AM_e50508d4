      location_note: newAlmariWing.trim() || 'Main Library Wing',
      shelf_count: shelfCount,
      approx_capacity: shelfCount * perShelfCap,
      is_active: true,
    });

    for (let s = 1; s <= shelfCount; s++) {
      handleSetShelfCapacity(created, s, perShelfCap);
