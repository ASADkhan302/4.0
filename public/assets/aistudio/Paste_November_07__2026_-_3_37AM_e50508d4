    const key = `${almari.id}::${shelfNo}`;
    setShelfCapacities((prev) => {
      const updated = { ...prev, [key]: clamped };
      try {
        localStorage.setItem('ulm_shelf_capacities_v1', JSON.stringify(updated));
      } catch {}
      return updated;
    });
  };

