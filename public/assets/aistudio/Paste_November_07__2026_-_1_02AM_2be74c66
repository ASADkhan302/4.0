      shelf: `Shelf ${shelfNo}`,
      placement_locked: true,
      location_source: 'manual',
    };

    const updatedList = books.map((b) => ((b.id === bookId || b.barcode === bookId) ? updatedBook : b));
    persistManualBookShelfAssignments([updatedBook]);
    if (onUpdateBooks) onUpdateBooks(updatedList);
  };

