import React, { useState, useMemo, useEffect, useRef } from 'react';
import {
  Library,
  Plus,
  MapPin,
  CheckCircle2,
  AlertCircle,
  X,
  GripVertical,
  BookMarked,
  Database,
  Edit2,
  Trash2,
  Settings2,
  AlertTriangle,
  Search,
} from 'lucide-react';
import { Book, Almari } from '../types/library';
import { AlmariService } from '../services/almariService';
import { StorageEngine } from '../services/storageEngine';

export interface AlmariViewProps {
  books: Book[];
  onUpdateBooks?: (updatedBooks: Book[]) => void;
  onSelectBook?: (book: Book) => void;
  onOpenBook?: (book: Book) => void;
}

const MASTER_PLACEMENTS_KEY = 'ulm_almari_placements_master_v3';
const ACTIVE_ALMARI_KEY = 'ulm_active_almari_id_v3';
const SHELF_CAPACITIES_KEY = 'ulm_shelf_capacities_v3';

const SPINE_PALETTES = [
  { bg: 'from-[#2A0845] to-[#1B032E]', border: 'border-[#FFD147]/50', text: 'text-[#FFD147]' }, // Royal ULM Purple
  { bg: 'from-[#7F1D1D] to-[#450A0A]', border: 'border-red-400/40', text: 'text-amber-200' },    // Burgundy Leather
  { bg: 'from-[#1E3A8A] to-[#0F172A]', border: 'border-blue-400/40', text: 'text-sky-200' },     // Oxford Navy
  { bg: 'from-[#064E3B] to-[#022C22]', border: 'border-emerald-400/40', text: 'text-emerald-200' }, // Forest Emerald
  { bg: 'from-[#78350F] to-[#451A03]', border: 'border-amber-400/50', text: 'text-amber-300' },   // Gold Ochre
  { bg: 'from-[#1E293B] to-[#0F172A]', border: 'border-slate-400/30', text: 'text-slate-200' },   // Obsidian Slate
];

export const AlmariView: React.FC<AlmariViewProps> = ({
  books,
  onUpdateBooks,
  onSelectBook,
  onOpenBook,
}) => {
  // 1. Persistent Cupboards Registry
  const [almaris, setAlmaris] = useState<Almari[]>(() => AlmariService.getAlmaris());

  // 2. Search Almari Query State
  const [almariSearchQuery, setAlmariSearchQuery] = useState<string>('');

  // 3. Persistent Selected Almari ID
  const [selectedAlmariId, setSelectedAlmariId] = useState<string>(() => {
    try {
      const saved = localStorage.getItem(ACTIVE_ALMARI_KEY);
      const all = AlmariService.getAlmaris();
      if (saved && all.some((a) => a.id === saved)) return saved;
      return all[0]?.id || '';
    } catch {
      return '';
    }
  });

  // 4. Authoritative Master Placements with Auto-Seeding
  const [masterPlacements, setMasterPlacements] = useState<
    Record<string, { almari_id: string; almari_code: string; shelf_no: number }>
  >(() => {
    let existingOverrides: Record<string, { almari_id: string; almari_code: string; shelf_no: number }> = {};
    try {
      const raw = localStorage.getItem(MASTER_PLACEMENTS_KEY);
      if (raw) existingOverrides = JSON.parse(raw);
    } catch {}

    const allAlmaris = AlmariService.getAlmaris();
    books.forEach((b) => {
      const key = b.id || b.barcode;
      if (!key) return;

      if (!existingOverrides[key]) {
        const matched = allAlmaris.find(
          (a) =>
            a.id === b.almari_id ||
            a.code.toUpperCase() === (b.almari_code || '').toUpperCase() ||
            a.code.toUpperCase() === (b.cupboard || '').toUpperCase()
        );
        const sNo = Number(b.shelf_no) || 0;
        if (matched && sNo >= 1) {
          existingOverrides[key] = {
            almari_id: matched.id,
            almari_code: matched.code,
            shelf_no: sNo,
          };
        }
      }
    });

    try {
      localStorage.setItem(MASTER_PLACEMENTS_KEY, JSON.stringify(existingOverrides));
    } catch {}

    return existingOverrides;
  });

  // 5. Merge incoming books with authoritative Master Placements
  const localBooks = useMemo(() => {
    return books.map((b) => {
      const override = (b.id && masterPlacements[b.id]) || (b.barcode && masterPlacements[b.barcode]);
      if (override) {
        return {
          ...b,
          almari_id: override.almari_id,
          almari_code: override.almari_code,
          shelf_no: override.shelf_no,
          cupboard: override.almari_code,
          shelf: `Shelf ${override.shelf_no}`,
          placement_locked: true,
        };
      }
      return b;
    });
  }, [books, masterPlacements]);

  // 6. Filtered Almaris by Search Query
  const filteredAlmaris = useMemo(() => {
    const q = almariSearchQuery.trim().toLowerCase();
    if (!q) return almaris;
    return almaris.filter((a) => {
      const codeMatch = a.code.toLowerCase().includes(q);
      const nameEnMatch = a.name_en ? a.name_en.toLowerCase().includes(q) : false;
      const nameUrMatch = a.name_ur ? a.name_ur.toLowerCase().includes(q) : false;
      const locMatch = (a.location || a.location_note || '').toLowerCase().includes(q);

      const booksInCupboard = localBooks.filter(
        (b) =>
          b.almari_id === a.id ||
          (b.almari_code && b.almari_code.toUpperCase() === a.code.toUpperCase()) ||
          (b.cupboard && b.cupboard.toUpperCase() === a.code.toUpperCase())
      );
      const bookMatch = booksInCupboard.some(
        (b) =>
          (b.book_name && b.book_name.toLowerCase().includes(q)) ||
          (b.title && b.title.toLowerCase().includes(q)) ||
          (b.author && b.author.toLowerCase().includes(q)) ||
          (b.barcode && b.barcode.toLowerCase().includes(q))
      );

      return codeMatch || nameEnMatch || nameUrMatch || locMatch || bookMatch;
    });
  }, [almaris, almariSearchQuery, localBooks]);

  const [dragOverShelfNo, setDragOverShelfNo] = useState<number | null>(null);
  const [hoveredBook, setHoveredBook] = useState<Book | null>(null);

  // Drag refs to prevent React state closure staleness
  const draggedBookRef = useRef<string | null>(null);
  const sourceShelfRef = useRef<number | null>(null);

  // Persistent Shelf Capacities (1–50)
  const [shelfCapacities, setShelfCapacities] = useState<Record<string, number>>(() => {
    try {
      const raw = localStorage.getItem(SHELF_CAPACITIES_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  });

  // Modal 1: Add Almari State
  const [isAddAlmariOpen, setIsAddAlmariOpen] = useState<boolean>(false);
  const [newAlmariCode, setNewAlmariCode] = useState<string>('');
  const [newAlmariName, setNewAlmariName] = useState<string>('');
  const [newAlmariWing, setNewAlmariWing] = useState<string>('Main Hall • Ground Floor');
  const [newAlmariShelves, setNewAlmariShelves] = useState<number>(5);
  const [newAlmariShelfCap, setNewAlmariShelfCap] = useState<number>(25);

  // Modal 2: Edit Almari State
  const [isEditAlmariOpen, setIsEditAlmariOpen] = useState<boolean>(false);
  const [editingAlmari, setEditingAlmari] = useState<Almari | null>(null);
  const [editAlmariCode, setEditAlmariCode] = useState<string>('');
  const [editAlmariName, setEditAlmariName] = useState<string>('');
  const [editAlmariWing, setEditAlmariWing] = useState<string>('');
  const [editAlmariShelves, setEditAlmariShelves] = useState<number>(5);
  const [editAlmariShelfCap, setEditAlmariShelfCap] = useState<number>(25);

  // Modal 3: Confirm Delete Almari State
  const [almariToDelete, setAlmariToDelete] = useState<Almari | null>(null);

  const [toastMessage, setToastMessage] = useState<{ type: 'success' | 'warning'; text: string } | null>(null);

  const selectedAlmari = useMemo(() => {
    return almaris.find((a) => a.id === selectedAlmariId) || almaris[0] || null;
  }, [almaris, selectedAlmariId]);

  const handleSelectAlmari = (id: string) => {
    setSelectedAlmariId(id);
    try {
      localStorage.setItem(ACTIVE_ALMARI_KEY, id);
    } catch {}
  };

  const getShelfCapacity = (almari: Almari, shelfNo: number): number => {
    const key = `${almari.id}::${shelfNo}`;
    if (shelfCapacities[key] !== undefined) return shelfCapacities[key];
    const perShelf = Math.max(
      1,
      Math.min(
        50,
        almari.books_per_shelf || Math.round((almari.approx_capacity || 125) / Math.max(1, almari.shelf_count || 5))
      )
    );
    return perShelf || 25;
  };

  const setShelfCapacity = (almari: Almari, shelfNo: number, cap: number) => {
    const clamped = Math.max(1, Math.min(50, cap));
    const key = `${almari.id}::${shelfNo}`;
    const next = { ...shelfCapacities, [key]: clamped };
    setShelfCapacities(next);
    try {
      localStorage.setItem(SHELF_CAPACITIES_KEY, JSON.stringify(next));
    } catch {}
  };

  // Group books by Almari & Shelf
  const placementMap = useMemo(() => {
    const byAlmariShelf = new Map<string, Book[]>();
    const unassigned: Book[] = [];

    for (const book of localBooks) {
      const matchedAlmari = almaris.find(
        (a) =>
          a.id === book.almari_id ||
          a.code.toUpperCase() === (book.almari_code || '').toUpperCase() ||
          a.code.toUpperCase() === (book.cupboard || '').toUpperCase()
      );
      const shelfNum = Number(book.shelf_no) || 0;

      if (matchedAlmari && shelfNum >= 1) {
        const key = `${matchedAlmari.id}::${shelfNum}`;
        const list = byAlmariShelf.get(key) || [];
        list.push(book);
        byAlmariShelf.set(key, list);
      } else {
        unassigned.push(book);
      }
    }

    return { byAlmariShelf, unassigned };
  }, [localBooks, almaris]);

  // Non-destructive Reassignment
  const executeReassignBook = (bookId: string, targetAlmari: Almari, targetShelf: number) => {
    if (!bookId || !targetAlmari) return;

    const targetBook = localBooks.find((b) => {
      if (b.id && b.id === bookId) return true;
      if (b.barcode && b.barcode === bookId) return true;
      return false;
    });

    if (!targetBook) return;

    const currentShelfBooks = placementMap.byAlmariShelf.get(`${targetAlmari.id}::${targetShelf}`) || [];
    const capacity = getShelfCapacity(targetAlmari, targetShelf);

    if (currentShelfBooks.length >= capacity && targetBook.shelf_no !== targetShelf) {
      setToastMessage({
        type: 'warning',
        text: `Shelf ${targetShelf} reached capacity (${currentShelfBooks.length}/${capacity} vols). Volume placed.`,
      });
    } else {
      setToastMessage({
        type: 'success',
        text: `Moved "${targetBook.book_name}" to ${targetAlmari.code} • Shelf ${targetShelf}`,
      });
    }

    const newOverrides = { ...masterPlacements };
    if (targetBook.id) {
      newOverrides[targetBook.id] = {
        almari_id: targetAlmari.id,
        almari_code: targetAlmari.code,
        shelf_no: targetShelf,
      };
    }
    if (targetBook.barcode) {
      newOverrides[targetBook.barcode] = {
        almari_id: targetAlmari.id,
        almari_code: targetAlmari.code,
        shelf_no: targetShelf,
      };
    }
    setMasterPlacements(newOverrides);

    try {
      localStorage.setItem(MASTER_PLACEMENTS_KEY, JSON.stringify(newOverrides));
    } catch (e) {
      console.error('LocalStorage write error:', e);
    }

    const updatedBook: Book = {
      ...targetBook,
      almari_id: targetAlmari.id,
      almari_code: targetAlmari.code,
      almari_name: targetAlmari.name_en,
      shelf_no: targetShelf,
      cupboard: targetAlmari.code,
      shelf: `Shelf ${targetShelf}`,
      placement_locked: true,
      location_source: 'manual',
    };

    StorageEngine.upsertBook({
      accession: updatedBook.barcode || updatedBook.accession_no || '',
      title: updatedBook.book_name,
      author: updatedBook.author,
      isbn: updatedBook.isbn || '',
      category: updatedBook.category || 'General',
      almariId: targetAlmari.id,
      shelfId: String(targetShelf),
      status: 'AVAILABLE',
      updatedAt: new Date().toISOString(),
    }).catch((err) => console.warn('StorageEngine sync note:', err));

    if (onUpdateBooks) {
      const updatedList = localBooks.map((b) => {
        const isThisBook =
          (targetBook.id && b.id && b.id === targetBook.id) ||
          (targetBook.barcode && b.barcode && b.barcode === targetBook.barcode);
        return isThisBook ? updatedBook : b;
      });
      onUpdateBooks(updatedList);
    }
  };

  const handleDragStart = (e: React.DragEvent, bookId: string, currentShelf?: number) => {
    e.dataTransfer.setData('text/plain', bookId);
    e.dataTransfer.effectAllowed = 'move';
    draggedBookRef.current = bookId;
    sourceShelfRef.current = currentShelf ?? null;
  };

  const handleDragOver = (e: React.DragEvent, shelfNo: number) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    if (dragOverShelfNo !== shelfNo) {
      setDragOverShelfNo(shelfNo);
    }
  };

  const handleDragLeave = () => {
    setDragOverShelfNo(null);
  };

  const handleDrop = (e: React.DragEvent, targetShelfNo: number) => {
    e.preventDefault();
    setDragOverShelfNo(null);
    const bookId = e.dataTransfer.getData('text/plain') || draggedBookRef.current;
    if (bookId && selectedAlmari) {
      executeReassignBook(bookId, selectedAlmari, targetShelfNo);
    }
    draggedBookRef.current = null;
    sourceShelfRef.current = null;
  };

  // Add Almari Handler
  const handleCreateManualAlmari = (e: React.FormEvent) => {
    e.preventDefault();
    const code = newAlmariCode.trim().toUpperCase() || `ALM-${String(almaris.length + 1).padStart(2, '0')}`;
    const nameEn = newAlmariName.trim() || `Academic Cupboard ${almaris.length + 1}`;
    const shelfCount = Math.max(1, Math.min(12, newAlmariShelves));
    const booksPerShelf = Math.max(1, Math.min(50, newAlmariShelfCap));
    const approxCap = shelfCount * booksPerShelf;

    const created = AlmariService.saveAlmari({
      code,
      name_en: nameEn,
      name_ur: nameEn,
      shelf_count: shelfCount,
      books_per_shelf: booksPerShelf,
      approx_capacity: approxCap,
      location: newAlmariWing,
      location_note: newAlmariWing,
      is_active: true,
      created_at: new Date().toISOString(),
    });

    const refreshed = AlmariService.getAlmaris();
    setAlmaris(refreshed);
    handleSelectAlmari(created.id);
    setIsAddAlmariOpen(false);
    setNewAlmariCode('');
    setNewAlmariName('');
    setToastMessage({
      type: 'success',
      text: `Cupboard ${created.code} successfully registered!`,
    });
  };

  // Open Edit Almari Modal
  const handleOpenEditModal = (almari: Almari) => {
    setEditingAlmari(almari);
    setEditAlmariCode(almari.code);
    setEditAlmariName(almari.name_en);
    setEditAlmariWing(almari.location || almari.location_note || 'Main Hall • Ground Floor');
    setEditAlmariShelves(almari.shelf_count || 5);
    setEditAlmariShelfCap(almari.books_per_shelf || 25);
    setIsEditAlmariOpen(true);
  };

  // Save Edited Almari
  const handleSaveEditedAlmari = (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingAlmari) return;

    const updatedShelves = Math.max(1, Math.min(12, editAlmariShelves));
    const updatedCap = Math.max(1, Math.min(50, editAlmariShelfCap));
    const approxCap = updatedShelves * updatedCap;

    const updated = AlmariService.saveAlmari({
      ...editingAlmari,
      code: editAlmariCode.trim().toUpperCase() || editingAlmari.code,
      name_en: editAlmariName.trim() || editingAlmari.name_en,
      name_ur: editAlmariName.trim() || editingAlmari.name_ur,
      location: editAlmariWing || editingAlmari.location,
      location_note: editAlmariWing || editingAlmari.location_note,
      shelf_count: updatedShelves,
      books_per_shelf: updatedCap,
      approx_capacity: approxCap,
    });

    const refreshed = AlmariService.getAlmaris();
    setAlmaris(refreshed);
    setIsEditAlmariOpen(false);
    setEditingAlmari(null);
    setToastMessage({
      type: 'success',
      text: `Cupboard ${updated.code} settings updated successfully!`,
    });
  };

  // Safe Delete Almari Protocol
  const handleConfirmDeleteAlmari = () => {
    if (!almariToDelete) return;

    const deletedId = almariToDelete.id;
    const deletedCode = almariToDelete.code;

    // 1. Unassign all books placed in this Almari
    const newOverrides = { ...masterPlacements };
    let reassignedCount = 0;

    localBooks.forEach((b) => {
      const isAssignedToThis =
        b.almari_id === deletedId ||
        (b.almari_code && b.almari_code.toUpperCase() === deletedCode.toUpperCase()) ||
        (b.cupboard && b.cupboard.toUpperCase() === deletedCode.toUpperCase());

      if (isAssignedToThis) {
        reassignedCount++;
        if (b.id && newOverrides[b.id]) delete newOverrides[b.id];
        if (b.barcode && newOverrides[b.barcode]) delete newOverrides[b.barcode];
      }
    });

    setMasterPlacements(newOverrides);
    try {
      localStorage.setItem(MASTER_PLACEMENTS_KEY, JSON.stringify(newOverrides));
    } catch {}

    const updatedBookList = localBooks.map((b) => {
      const isAssignedToThis =
        b.almari_id === deletedId ||
        (b.almari_code && b.almari_code.toUpperCase() === deletedCode.toUpperCase()) ||
        (b.cupboard && b.cupboard.toUpperCase() === deletedCode.toUpperCase());

      if (isAssignedToThis) {
        return {
          ...b,
          almari_id: '',
          almari_code: '',
          almari_name: '',
          shelf_no: 0,
          cupboard: '',
          shelf: '',
          placement_locked: false,
        };
      }
      return b;
    });

    // 2. Remove from Registry
    AlmariService.deleteAlmari(deletedId);
    const refreshed = AlmariService.getAlmaris();
    setAlmaris(refreshed);

    // 3. Switch to another Almari if the active one was deleted
    const nextAlmariId = refreshed.length > 0 ? refreshed[0].id : '';
    handleSelectAlmari(nextAlmariId);

    // 4. Update parent books
    if (onUpdateBooks) {
      onUpdateBooks(updatedBookList);
    }

    // 5. Close modals & show notification
    setAlmariToDelete(null);
    setIsEditAlmariOpen(false);
    setEditingAlmari(null);
    setToastMessage({
      type: 'success',
      text: `Cupboard ${deletedCode} deleted. All allocated volumes safely moved to Unassigned Queue.`,
    });
  };

  const activeAlmariBooksCount = useMemo(() => {
    if (!selectedAlmari) return 0;
    let count = 0;
    for (let s = 1; s <= (selectedAlmari.shelf_count || 5); s++) {
      count += (placementMap.byAlmariShelf.get(`${selectedAlmari.id}::${s}`) || []).length;
    }
    return count;
  }, [selectedAlmari, placementMap]);

  return (
    <div className="space-y-4 pb-16 select-none">
      {/* Top Toolbar with Live Database Sync HUD */}
      <div className="p-3.5 rounded-2xl bg-white/65 dark:bg-[#140D22]/65 backdrop-blur-2xl border border-[#C8963E]/30 dark:border-white/10 flex flex-wrap items-center justify-between gap-3 shadow-xs">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-[#541A72] to-[#3B1054] border border-[#FFD147]/50 flex items-center justify-center text-[#FFD147] shadow-sm shrink-0">
            <Library className="w-5 h-5" />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h2 className="text-base font-extrabold text-slate-900 dark:text-white tracking-tight">
                Physical Almari Cupboard &amp; 3D Bookshelf Registry
              </h2>
              {/* LIVE DATABASE SYNC HUD */}
              <span className="px-2 py-0.5 rounded-full text-[10px] font-mono font-extrabold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
                <Database className="w-3 h-3 text-emerald-600 dark:text-emerald-400" />
                <span>DB SYNCED • {activeAlmariBooksCount} VOLS LOCKED IN {selectedAlmari?.code || 'ALMARI'}</span>
              </span>
            </div>
            <p className="text-[11px] text-slate-500 dark:text-slate-400">
              Drag volumes directly between physical shelves. Moving a volume keeps all sibling books locked in place.
            </p>
          </div>
        </div>

        {/* Action Button: Add Almari */}
        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={() => setIsAddAlmariOpen(true)}
            className="h-9 px-4 rounded-xl text-xs font-extrabold bg-gradient-to-r from-[#541A72] to-[#B4690E] text-white border border-[#FFD147]/50 shadow-xs hover:brightness-110 cursor-pointer flex items-center gap-1.5"
          >
            <Plus className="w-3.5 h-3.5" />
            <span>+ Add Almari</span>
          </button>
        </div>
      </div>

      {toastMessage && (
        <div className={`px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between border ${
          toastMessage.type === 'warning'
            ? 'bg-amber-500/15 border-amber-500/40 text-amber-900 dark:text-amber-200'
            : 'bg-emerald-500/15 border-emerald-500/40 text-emerald-900 dark:text-emerald-200'
        }`}>
          <div className="flex items-center gap-2">
            {toastMessage.type === 'warning' ? (
              <AlertCircle className="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" />
            ) : (
              <CheckCircle2 className="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
            )}
            <span>{toastMessage.text}</span>
          </div>
          <button
            type="button"
            onClick={() => setToastMessage(null)}
            className="text-[11px] underline opacity-80 hover:opacity-100 cursor-pointer"
          >
            Dismiss
          </button>
        </div>
      )}

      {/* Main Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-4">
