              className="h-9 px-3.5 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 border border-slate-200 dark:border-white/15 text-slate-800 dark:text-slate-200 hover:bg-white cursor-pointer flex items-center gap-1.5"
            >
              <Upload className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
              <span>Import Excel/CSV</span>
            </button>

            <button
              type="button"
              className="h-9 px-3.5 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 border border-slate-200 dark:border-white/15 text-slate-800 dark:text-slate-200 hover:bg-white cursor-pointer flex items-center gap-1.5"
            >
              <Printer className="w-3.5 h-3.5 text-slate-600 dark:text-slate-300" />
              <span>Print Barcodes</span>
            </button>

            <button
              type="button"
              onClick={onExportCatalog}
              className="h-9 px-3.5 rounded-xl text-xs font-semibold bg-white/70 dark:bg-white/10 border border-slate-200 dark:border-white/15 text-slate-800 dark:text-slate-200 hover:bg-white cursor-pointer flex items-center gap-1.5"
            >
              <FileSpreadsheet className="w-3.5 h-3.5 text-[#C8963E]" />
              <span>CSV Template</span>
            </button>

            <button
              type="button"
              onClick={onOpenAddBook}
              className="h-9 px-4 rounded-xl text-xs font-extrabold bg-gradient-to-r from-[#541A72] to-[#B4690E] text-white border border-[#FFD147]/50 shadow-md hover:brightness-110 cursor-pointer flex items-center gap-1.5"
            >
              <Plus className="w-4 h-4" />
              <span>+ Add Book</span>
            </button>
          </div>
        </div>
      </div>

      {/* =========================================================================
          SECTION 3: CONDITIONAL VIEW RENDERER (GRID / LIST / ALMARI / ANALYTICS)
          ========================================================================= */}

      {/* VIEW A: IPHONE LIQUID-GLASS GRID VIEW (DEFAULT) */}
      {catalogView === 'grid' && (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {paginatedBooks.map((book) => {
            const isSelected = selectedBookIds.has(book.id || book.barcode);
            const isUrdu = /[\u0600-\u06FF]/.test(book.book_name || '');

            return (
              <div
                key={book.id || book.barcode}
                className={`group relative rounded-[22px] bg-white/65 hover:bg-white/85 dark:bg-[#150D24]/65 dark:hover:bg-[#1A102D]/85 backdrop-blur-2xl backdrop-saturate-200 border transition-all duration-200 p-4 flex flex-col justify-between shadow-[0_8px_28px_rgba(0,0,0,0.04),inset_0_1px_0_rgba(255,255,255,0.7)] dark:shadow-[0_8px_28px_rgba(0,0,0,0.45),inset_0_1px_0_rgba(255,255,255,0.08)] hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(200,150,62,0.18)] ${
                  isSelected
                    ? 'border-[#FFD147] ring-2 ring-[#FFD147]/40'
                    : 'border-[#C8963E]/30 dark:border-white/10'
                }`}
              >
                <div>
                  {/* Top Header: Spine + Tags + Selection Checkbox */}
                  <div className="flex items-start gap-3">
                    {/* 3D Leather/Cloth Volume Spine Mockup */}
                    <div className="w-[58px] h-[78px] rounded-lg bg-gradient-to-br from-[#240836] via-[#3B1054] to-[#1E0730] border border-[#FFD147]/40 shadow-md flex flex-col items-center justify-between p-1.5 shrink-0 relative overflow-hidden">
                      <div className="absolute left-1 top-0 bottom-0 w-[2px] bg-black/40" />
                      <span className="text-[7px] font-mono font-bold text-[#FFD147] tracking-widest uppercase">
                        ULM
                      </span>
                      <BookMarked className="w-4 h-4 text-[#FFD147]" />
                      <span className="text-[6px] font-extrabold uppercase text-white/80 tracking-widest">
                        PRESS
                      </span>
                    </div>

                    {/* Metadata & Tag Badges */}
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center justify-between gap-1 mb-1">
                        <div className="flex items-center gap-1 flex-wrap">
                          <span className="px-2 py-0.5 rounded-md text-[9px] font-bold bg-[#541A72]/15 text-[#541A72] dark:text-[#FFD147] border border-[#541A72]/30">
                            {book.category || 'General'}
                          </span>
                          <span className="px-1.5 py-0.5 rounded-md text-[9px] font-semibold bg-slate-100 dark:bg-white/10 text-slate-600 dark:text-slate-300">
                            {book.language || 'English'}
                          </span>
                          {book.edition && (
                            <span className="px-1.5 py-0.5 rounded-md text-[9px] font-semibold bg-amber-500/15 text-amber-700 dark:text-amber-400">
                              {book.edition}
                            </span>
                          )}
                        </div>

                        {/* Selection Checkbox */}
                        <input
                          type="checkbox"
                          checked={isSelected}
                          onChange={() => handleToggleSelectOne(book.id || book.barcode)}
                          className="w-4 h-4 rounded text-[#541A72] border-slate-300 dark:border-white/20 cursor-pointer"
                        />
                      </div>

                      {/* Title */}
                      <h3
                        onClick={() => onSelectBook && onSelectBook(book)}
                        className={`font-extrabold text-sm text-slate-900 dark:text-white line-clamp-2 cursor-pointer hover:text-[#541A72] dark:hover:text-[#FFD147] transition-colors leading-snug ${
                          isUrdu ? 'font-serif text-base' : ''
                        }`}
                        title={book.book_name}
                      >
                        {book.book_name}
                      </h3>

                      {/* Author */}
                      <p className="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 truncate">
                        by {book.author || 'Unknown Author'}
                      </p>
                    </div>
                  </div>

                  {/* Accession & Barcode Badge Strip */}
                  <div className="mt-3 pt-2.5 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between gap-2 text-[10px]">
                    <div className="flex items-center gap-1.5">
                      <span className="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-800 dark:text-amber-300 font-mono font-bold">
                        {book.accession_no || '000 ULM'}
                      </span>
                      <span className="font-mono text-slate-500 dark:text-slate-400 font-semibold truncate max-w-[110px]">
                        #{book.barcode}
                      </span>
                    </div>

                    <span className="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border border-emerald-500/30">
                      🟢 {book.available_quantity ?? 1} Available
                    </span>
                  </div>

                  {/* Physical Shelf / Almari Placement */}
                  <div className="mt-2 flex items-center gap-1 text-[11px] text-slate-600 dark:text-slate-300">
                    <MapPin className="w-3 h-3 text-[#C8963E] shrink-0" />
                    <span className="truncate font-medium">
                      {book.almari_code ? `${book.almari_code} • ${book.shelf || 'Shelf 1'}` : 'Unassigned (No Almari)'}
                    </span>
                  </div>
                </div>

                {/* Card Action Footer */}
                <div className="mt-4 pt-3 border-t border-slate-200/60 dark:border-white/10 flex items-center justify-between gap-2">
                  <div className="flex items-center gap-1.5">
                    <button
                      type="button"
                      onClick={() => onSelectBook && onSelectBook(book)}
                      className="h-7 px-2.5 rounded-lg text-[11px] font-semibold bg-slate-100 dark:bg-white/10 text-slate-700 dark:text-slate-300 hover:bg-slate-200 cursor-pointer"
                    >
                      Details
                    </button>
                    <button
                      type="button"
                      onClick={() => onOpenIssueModal && onOpenIssueModal(book)}
                      className="h-7 px-3 rounded-lg text-[11px] font-extrabold bg-[#C8963E] text-slate-950 hover:brightness-110 cursor-pointer shadow-xs"
                    >
                      Issue
                    </button>
                  </div>

                  <div className="flex items-center gap-1 text-slate-400">
                    <button
                      type="button"
                      onClick={() => onEditBook && onEditBook(book)}
                      className="p-1.5 rounded-md hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-white/10 cursor-pointer"
                      title="Edit Book Details"
                    >
                      <Edit3 className="w-3.5 h-3.5" />
                    </button>
                    <button
                      type="button"
                      onClick={() => onDeleteBook && onDeleteBook(book)}
                      className="p-1.5 rounded-md hover:text-rose-600 hover:bg-rose-500/10 cursor-pointer"
                      title="Delete Record"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

      {/* VIEW B: LIST VIEW (TABLE) */}
      {catalogView === 'list' && (
        <div className="rounded-[22px] bg-white/60 dark:bg-[#140D22]/60 backdrop-blur-2xl backdrop-saturate-200 border border-[#C8963E]/35 dark:border-white/10 overflow-hidden shadow-sm">
          <div className="overflow-x-auto">
            <table className="w-full text-left text-xs">
              <thead className="bg-slate-50/80 dark:bg-black/35 border-b border-slate-200/80 dark:border-white/10 text-slate-500 dark:text-slate-400 uppercase tracking-wider font-bold">
                <tr>
                  <th className="py-3 px-4 w-10">
                    <input
                      type="checkbox"
                      checked={selectedBookIds.size === paginatedBooks.length && paginatedBooks.length > 0}
                      onChange={handleToggleSelectAll}
                      className="rounded"
                    />
                  </th>
                  <th className="py-3 px-4">Book Title & Author</th>
                  <th className="py-3 px-4">Category</th>
                  <th className="py-3 px-4">Language</th>
                  <th className="py-3 px-4">Barcode / Call No</th>
                  <th className="py-3 px-4">Total</th>
                  <th className="py-3 px-4">Avail</th>
                  <th className="py-3 px-4">Shelf / Row</th>
                  <th className="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-200/60 dark:divide-white/10 text-slate-800 dark:text-slate-200">
                {paginatedBooks.map((book) => (
                  <tr key={book.id || book.barcode} className="hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                    <td className="py-3 px-4">
                      <input
                        type="checkbox"
                        checked={selectedBookIds.has(book.id || book.barcode)}
                        onChange={() => handleToggleSelectOne(book.id || book.barcode)}
                        className="rounded"
                      />
                    </td>
                    <td className="py-3 px-4 max-w-[280px]">
                      <p className="font-bold text-slate-900 dark:text-white truncate">{book.book_name}</p>
                      <p className="text-[11px] text-slate-500 dark:text-slate-400 truncate">{book.author}</p>
                    </td>
                    <td className="py-3 px-4">{book.category || 'General'}</td>
                    <td className="py-3 px-4">{book.language || 'English'}</td>
                    <td className="py-3 px-4 font-mono">{book.barcode}</td>
                    <td className="py-3 px-4 font-mono font-bold">{book.total_quantity ?? 1}</td>
                    <td className="py-3 px-4 font-mono font-bold text-emerald-600 dark:text-emerald-400">
                      {book.available_quantity ?? 1}
                    </td>
                    <td className="py-3 px-4 text-slate-500 dark:text-slate-400">
                      {book.almari_code ? `${book.almari_code} • ${book.shelf || 'S1'}` : 'Unassigned'}
                    </td>
                    <td className="py-3 px-4 text-right">
                      <div className="flex items-center justify-end gap-1.5">
                        <button
                          type="button"
                          onClick={() => onOpenIssueModal && onOpenIssueModal(book)}
                          className="px-2.5 py-1 rounded bg-[#C8963E] text-slate-950 font-bold hover:brightness-110"
                        >
                          Loan
                        </button>
                        <button
                          type="button"
                          onClick={() => onEditBook && onEditBook(book)}
                          className="p-1 rounded hover:bg-slate-200 dark:hover:bg-white/10"
                        >
                          <Edit3 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* VIEW C: PHYSICAL ALMARI & SHELF VIEW */}
      {catalogView === 'almaris' && (
        <AlmariView books={books} onSelectBook={onSelectBook} />
      )}

      {/* VIEW D: CATALOG VISUAL ANALYTICS (RECHARTS SUITE) */}
      {catalogView === 'analytics' && (
        <CatalogVisualAnalytics />
      )}

      {/* =========================================================================
          SECTION 4: IPHONE STYLE TRANSLUCENT PAGINATION BAR
          ========================================================================= */}
      {catalogView !== 'analytics' && catalogView !== 'almaris' && (
        <div className="rounded-[20px] bg-white/60 dark:bg-[#140D22]/60 backdrop-blur-2xl border border-[#C8963E]/35 dark:border-white/10 p-3.5 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400 shadow-sm">
          <div className="flex items-center gap-3">
            <span>
              Showing <strong>{(currentPage - 1) * pageSize + 1}</strong> to{' '}
              <strong>{Math.min(currentPage * pageSize, filteredBooks.length)}</strong> of{' '}
              <strong>{filteredBooks.length.toLocaleString()}</strong> books
            </span>
            <div className="flex items-center gap-1.5">
              <span>Per page:</span>
              <select
                value={pageSize}
                onChange={(e) => {
                  setPageSize(Number(e.target.value));
                  setCurrentPage(1);
                }}
                className="h-8 px-2 rounded-lg bg-white/80 dark:bg-black/35 border border-slate-300 dark:border-white/15 text-slate-900 dark:text-white"
              >
                <option value={24}>24</option>
                <option value={48}>48</option>
                <option value={50}>50</option>
                <option value={100}>100</option>
              </select>
            </div>
          </div>

          <div className="flex items-center gap-1">
            <button
              type="button"
              disabled={currentPage <= 1}
              onClick={() => setCurrentPage(1)}
              className="p-1.5 rounded-lg border border-slate-200 dark:border-white/10 disabled:opacity-40 hover:bg-black/5"
            >
              <ChevronsLeft className="w-4 h-4" />
            </button>
            <button
              type="button"
              disabled={currentPage <= 1}
              onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
              className="p-1.5 rounded-lg border border-slate-200 dark:border-white/10 disabled:opacity-40 hover:bg-black/5"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>
            <span className="px-3 py-1 font-mono font-bold text-slate-900 dark:text-white">
              Page {currentPage} of {totalPages}
            </span>
            <button
              type="button"
              disabled={currentPage >= totalPages}
              onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
              className="p-1.5 rounded-lg border border-slate-200 dark:border-white/10 disabled:opacity-40 hover:bg-black/5"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
            <button
              type="button"
              disabled={currentPage >= totalPages}
              onClick={() => setCurrentPage(totalPages)}
              className="p-1.5 rounded-lg border border-slate-200 dark:border-white/10 disabled:opacity-40 hover:bg-black/5"
            >
              <ChevronsRight className="w-4 h-4" />
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

export default BooksCatalogView;


