import { Almari, BookGroup } from '../types/library';

const ALMARIS_STORAGE_KEY = 'ulm_almaris_registry_v2';

const DEFAULT_ALMARIS: Almari[] = [
  {
    id: 'alm-ih-01',
    code: 'IH',
    name_en: 'Institutional Holdings & Main Stack',
    name_ur: 'مرکزی کتب خانہ الماری',
    location_note: 'Main Hall • Ground Floor',
    shelf_count: 5,
    approx_capacity: 125,
    is_active: true,
  },
];

export class AlmariService {
  public static getAlmaris(): Almari[] {
    if (typeof window === 'undefined') return DEFAULT_ALMARIS;
    try {
      const raw = localStorage.getItem(ALMARIS_STORAGE_KEY);
      if (!raw) {
        localStorage.setItem(ALMARIS_STORAGE_KEY, JSON.stringify(DEFAULT_ALMARIS));
        return DEFAULT_ALMARIS;
      }
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) && parsed.length > 0 ? parsed : DEFAULT_ALMARIS;
    } catch {
      return DEFAULT_ALMARIS;
    }
  }

  public static saveAlmari(almariData: Omit<Almari, 'id'> & { id?: string }): Almari {
    const current = this.getAlmaris();
    const id = almariData.id || `alm-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`;
    const newAlmari: Almari = {
      ...almariData,
      id,
    };

    const idx = current.findIndex((a) => a.id === id || a.code === newAlmari.code);
    let updated: Almari[];
    if (idx >= 0) {
      updated = [...current];
      updated[idx] = newAlmari;
    } else {
      updated = [...current, newAlmari];
    }

    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(ALMARIS_STORAGE_KEY, JSON.stringify(updated));
      } catch (e) {
        console.error('[AlmariService] Failed to save almari:', e);
      }
    }
    return newAlmari;
  }

  public static deleteAlmari(id: string): boolean {
    const current = this.getAlmaris();
    const filtered = current.filter((a) => a.id !== id);
    if (typeof window !== 'undefined') {
      try {
        localStorage.setItem(ALMARIS_STORAGE_KEY, JSON.stringify(filtered));
      } catch {}
    }
    return filtered.length !== current.length;
  }

  public static getGroups(): BookGroup[] {
    return [];
  }
}

export default AlmariService;



